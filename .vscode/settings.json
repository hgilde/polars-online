{
  // rustup installs to ~/.cargo/bin and uv to ~/.local/bin; neither is on the
  // default PATH of a login shell on every machine. Putting them here means an
  // integrated terminal can run `cargo` and `uv` with no per-machine setup.
  // The equivalent for a plain shell is `source scripts/env.sh`.
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:${env:PATH}"
  },
  "terminal.integrated.env.windows": {
    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:USERPROFILE}\\.local\\bin;${env:PATH}"
  },

  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  // online-py needs a >= 3.12 interpreter at build time (pyo3 abi3-py312).
  // VIRTUAL_ENV rather than PYO3_PYTHON because this key cannot be made
  // OS-specific: pyo3 resolves the venv to bin/python or Scripts\python.exe
  // itself, so one value works on all three platforms where a hardcoded
  // interpreter path would break Windows.
  "rust-analyzer.cargo.extraEnv": { "VIRTUAL_ENV": "${workspaceFolder}/.venv" },
  "rust-analyzer.check.command": "clippy",

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  "[rust]": { "editor.formatOnSave": true },
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "files.watcherExclude": { "**/target/**": true, "**/.venv/**": true }
}
